# Tailwind CSS Zinc. Full btop++ 1.4.7 palette, including process states.
theme[main_bg]="#09090b"
theme[main_fg]="#d4d4d8"
theme[title]="#fafafa"
theme[hi_fg]="#fafafa"
theme[selected_bg]="#fafafa"
theme[selected_fg]="#09090b"
theme[inactive_fg]="#71717a"
theme[graph_text]="#71717a"
theme[meter_bg]="#27272a"
theme[proc_misc]="#a1a1aa"
theme[cpu_box]="#52525b"
theme[mem_box]="#52525b"
theme[net_box]="#52525b"
theme[proc_box]="#52525b"
theme[div_line]="#3f3f46"

# Higher load becomes brighter; free/available memory uses the reverse scale.
theme[temp_start]="#71717a"
theme[temp_mid]="#d4d4d8"
theme[temp_end]="#fafafa"
theme[cpu_start]="#71717a"
theme[cpu_mid]="#d4d4d8"
theme[cpu_end]="#fafafa"
theme[free_start]="#fafafa"
theme[free_mid]="#d4d4d8"
theme[free_end]="#71717a"
theme[cached_start]="#52525b"
theme[cached_mid]="#a1a1aa"
theme[cached_end]="#e4e4e7"
theme[available_start]="#fafafa"
theme[available_mid]="#d4d4d8"
theme[available_end]="#71717a"
theme[used_start]="#71717a"
theme[used_mid]="#d4d4d8"
theme[used_end]="#fafafa"
theme[download_start]="#71717a"
theme[download_mid]="#d4d4d8"
theme[download_end]="#fafafa"
theme[upload_start]="#52525b"
theme[upload_mid]="#a1a1aa"
theme[upload_end]="#e4e4e7"
theme[process_start]="#71717a"
theme[process_mid]="#d4d4d8"
theme[process_end]="#fafafa"

theme[proc_pause_bg]="#52525b"
theme[proc_follow_bg]="#3f3f46"
theme[proc_banner_bg]="#27272a"
theme[proc_banner_fg]="#fafafa"
theme[followed_bg]="#3f3f46"
theme[followed_fg]="#fafafa"
