<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>name</key><string>Tailwind Zinc</string>
    <key>settings</key>
    <array>
        <dict>
            <key>settings</key>
            <dict>
                <key>background</key><string>#09090b</string>
                <key>foreground</key><string>#d4d4d8</string>
                <key>caret</key><string>#fafafa</string>
                <key>selection</key><string>#3f3f46</string>
                <key>lineHighlight</key><string>#18181b</string>
            </dict>
        </dict>
        <dict>
            <key>scope</key><string>comment, punctuation.definition.comment</string>
            <key>settings</key><dict>
                <key>foreground</key><string>#71717a</string>
                <key>fontStyle</key><string>italic</string>
            </dict>
        </dict>
        <dict>
            <key>scope</key><string>keyword, storage, entity.name.tag</string>
            <key>settings</key><dict>
                <key>foreground</key><string>#fafafa</string>
                <key>fontStyle</key><string>bold</string>
            </dict>
        </dict>
        <dict>
            <key>scope</key><string>string, markup.raw</string>
            <key>settings</key><dict><key>foreground</key><string>#a1a1aa</string></dict>
        </dict>
        <dict>
            <key>scope</key><string>constant, variable.language, support.constant</string>
            <key>settings</key><dict><key>foreground</key><string>#e4e4e7</string></dict>
        </dict>
        <dict>
            <key>scope</key><string>entity.name.function, entity.name.type, support.function, support.type</string>
            <key>settings</key><dict><key>foreground</key><string>#d4d4d8</string></dict>
        </dict>
        <dict>
            <key>scope</key><string>punctuation, meta.brace</string>
            <key>settings</key><dict><key>foreground</key><string>#a1a1aa</string></dict>
        </dict>
        <dict>
            <key>scope</key><string>markup.heading, markup.bold</string>
            <key>settings</key><dict>
                <key>foreground</key><string>#fafafa</string>
                <key>fontStyle</key><string>bold</string>
            </dict>
        </dict>
        <dict>
            <key>scope</key><string>markup.italic</string>
            <key>settings</key><dict><key>fontStyle</key><string>italic</string></dict>
        </dict>
        <dict>
            <key>scope</key><string>markup.inserted</string>
            <key>settings</key><dict><key>foreground</key><string>#e4e4e7</string></dict>
        </dict>
        <dict>
            <key>scope</key><string>markup.deleted</string>
            <key>settings</key><dict>
                <key>foreground</key><string>#a1a1aa</string>
                <key>fontStyle</key><string>strikethrough</string>
            </dict>
        </dict>
        <dict>
            <key>scope</key><string>invalid</string>
            <key>settings</key><dict>
                <key>foreground</key><string>#fafafa</string>
                <key>background</key><string>#52525b</string>
            </dict>
        </dict>
    </array>
</dict>
</plist>
