mpd_host = "@RUNTIME_DIR@/mpd/socket"
mpd_port = "6600"

# Zinc theme shared with Yazi and Foot.
# Foot: default = zinc-50 on zinc-900; white = zinc-300;
# black = zinc-800; 9 (ANSI bright black, numbered from 1) = zinc-500.
colors_enabled = yes
main_window_color = default
header_window_color = default
statusbar_color = white
volume_color = white
state_line_color = 9
state_flags_color = white
color1 = white
color2 = 9
empty_tag_color = 9
progressbar_color = black
progressbar_elapsed_color = default
statusbar_time_color = default
player_state_color = default:b
alternative_ui_separator_color = 9
window_border_color = 9
active_window_border = white
visualizer_color = white, 9, default

# Focused selection: zinc-900 text on zinc-50, like Yazi's active item.
current_item_prefix = $b$r
current_item_suffix = $/r$/b
current_item_inactive_column_prefix = $(white)$r
current_item_inactive_column_suffix = $/r$(end)
now_playing_prefix = $b
now_playing_suffix = $/b
selected_item_prefix = $(white)$b
selected_item_suffix = $/b$(end)
modified_item_prefix = $(white)> $(end)
browser_playlist_prefix = "$(white)playlist$(end) "
discard_colors_if_item_is_selected = yes

# Keep the default layouts while replacing their inline accent colors.
song_list_format = {%a - }{%t}|{$(white)%f$(end)}$R{$(9)%l$(end)}
song_columns_list_format = (20)[white]{a} (6f)[9]{NE} (50)[default]{t|f:Title} (20)[white]{b} (7f)[9]{l}
alternative_header_first_line_format = $b$(9)$aqqu$/a$(end) {%t}|{%f} $(9)$atqq$/a$(end)$/b
alternative_header_second_line_format = {{$b%a$/b}{ - $(white)%b$(end)}{ ($(9)%y$(end))}}|{%D}
