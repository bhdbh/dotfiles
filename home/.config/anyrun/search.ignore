# Search exclusions. Uses gitignore syntax, relative to each indexed root.
# Patterns ending in / exclude directories at any depth.
# Later !patterns can override earlier file rules (parents must stay included).

# Dependency trees and disposable development output
node_modules/
__pycache__/
.venv/
venv/
.tox/
.nox/
.gradle/
target/
build/
dist/
coverage/
htmlcov/

# Caches, logs and temporary directories
cache/
Cache/
Caches/
logs/
Logs/
log/
tmp/
temp/

# Files generated by applications and editors
*.log
*.log.*
*.tmp
*.temp
*.swp
*.swo
*.pyc
*.pyo
*~

# Filesystem and desktop metadata
System Volume Information/
$RECYCLE.BIN/
lost+found/
.DS_Store
Thumbs.db
desktop.ini
