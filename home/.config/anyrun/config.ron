Config(
    x: Fraction(0.5),
    y: Fraction(0.5),

    width: Absolute(480),
    height: Absolute(1),

    hide_icons: true,
    hide_plugin_info: true,

    ignore_exclusive_zones: true,
    layer: Overlay,

    follow_mouse: true,

    // Used only when a pointer is unavailable.
    preferred_monitor: Some("HDMI-A-1"),
    fallback_monitor: Some("eDP-1"),

    close_on_click: true,
    show_results_immediately: true,
    max_entries: Some(6),
    search_delay_ms: 150,

    // Prefixes: > applications; # directories; @ files; : actions; $ shell; = calculator.
    provider: "@HOME@/.local/libexec/anyrun-prefix-provider",

    plugins: [
        "libapplications.so",
        "libshell.so",
        "librink.so",
        "libkidex.so",
        "libactions.so",
    ],
)
