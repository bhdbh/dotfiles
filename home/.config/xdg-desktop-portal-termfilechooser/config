[filechooser]
cmd=@HOME@/.config/xdg-desktop-portal-termfilechooser/yazi-wrapper.sh
default_dir=@HOME@
env=TERMCMD=/usr/bin/foot --app-id=yazi-filechooser --title=Yazi
env=PATH=@HOME@/.cargo/bin:@HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
create_help_file=1
open_mode=suggested
save_mode=suggested
