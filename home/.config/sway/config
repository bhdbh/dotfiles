# Sessão
xwayland disable
swaybg_command @HOME@/.local/bin/swaybg

# Variáveis
set $mod Mod4
set $term foot
set $menu env PATH=@HOME@/.cargo/bin:/usr/local/bin:/usr/bin:/bin @HOME@/.cargo/bin/anyrun

# Aparência
set $zinc50  #fafafa
set $zinc100 #f4f4f5
set $zinc200 #e4e4e7
set $zinc400 #a1a1aa
set $zinc500 #71717a
set $zinc600 #52525b
set $zinc700 #3f3f46
set $zinc800 #27272a
set $zinc900 #18181b
font pango:Red Hat Mono SemiBold 15px
client.focused          $zinc500 $zinc800  $zinc50  $zinc500 $zinc500
client.focused_inactive $zinc600 $zinc900  $zinc200 $zinc600 $zinc600
client.unfocused        $zinc600 $zinc900  $zinc400 $zinc600 $zinc600
client.urgent           $zinc600 $zinc700  $zinc100 $zinc600 $zinc600
client.placeholder      $zinc600 $zinc900  $zinc500 $zinc600 $zinc600
# Fundo nativo: acompanha a janela na mesma transação do Sway.
client.background border
default_border pixel 3
default_floating_border pixel 3
for_window [all] border pixel 3
hide_edge_borders none
smart_borders off
gaps inner 6
gaps outer 0
smart_gaps off
floating_modifier $mod normal
# Redimensionar apenas com Super + botão direito; bloquear arraste das bordas.
include @HOME@/.config/sway/border-no-resize.conf
focus_follows_mouse yes
mouse_warping none

# Monitores
output eDP-1 mode 1366x768@60.059Hz pos 0 312 scale 1
output HDMI-A-1 mode 1920x1080@143.981Hz pos 1366 0 scale 1
output * bg ~/Pictures/Wallpapers/wallpaper-zinc.png fill $zinc900

# Entradas
input type:pointer {
    accel_profile flat
    pointer_accel 0
}
input type:touchpad {
    tap enabled
    natural_scroll enabled
    scroll_factor 0.1875
    dwt enabled
}
input "type:keyboard" {
    xkb_layout us_custom,br
    xkb_variant ,abnt2
    repeat_delay 300
    repeat_rate 35
}
# Manter a seta nas bordas cujo arraste está bloqueado.
seat * xcursor_theme Bibata-Material-Noir-Sway 24

# Workspaces
workspace "__secondary_eDP-1" output eDP-1
workspace 1 output HDMI-A-1 eDP-1
workspace 2 output HDMI-A-1 eDP-1
workspace 3 output HDMI-A-1 eDP-1
workspace 4 output HDMI-A-1 eDP-1
workspace 5 output HDMI-A-1 eDP-1
workspace 6 output HDMI-A-1 eDP-1
workspace 7 output HDMI-A-1 eDP-1
workspace 8 output HDMI-A-1 eDP-1
workspace 9 output HDMI-A-1 eDP-1
workspace 10 output HDMI-A-1 eDP-1

# Inicialização
include @HOME@/.config/sway/yazi-filechooser.conf
# O auxiliar inicia a Waybar e transfere a barra ao trocar de monitor.
exec_always @HOME@/.local/bin/sway-primary-workspaces
exec_always @HOME@/.local/bin/sway-session-idle
exec systemd-inhibit --what=handle-lid-switch --mode=block --who=Sway --why="Lid only controls the built-in display" swaymsg -m -t subscribe '["shutdown"]'
exec ibus start --type wayland

# Atalhos
bindsym --locked XF86MonBrightnessDown exec @HOME@/.local/bin/laptop-brightness down
bindsym --locked XF86MonBrightnessUp exec @HOME@/.local/bin/laptop-brightness up
bindsym --locked XF86AudioLowerVolume exec /usr/bin/python3 @HOME@/.config/waybar/scripts/audio-output.py --down
bindsym --locked XF86AudioRaiseVolume exec /usr/bin/python3 @HOME@/.config/waybar/scripts/audio-output.py --up
bindsym --locked --no-repeat XF86AudioMute exec /usr/bin/wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

bindsym $mod+Return exec $term
bindsym $mod+Escape kill
bindsym $mod+d exec $menu

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

bindsym $mod+f fullscreen
bindsym $mod+g floating toggle
bindsym $mod+r layout toggle split

# A tampa remove a tela interna da área de trabalho e a restaura ao abrir.
bindswitch --locked --reload lid:on output eDP-1 disable
bindswitch --locked --reload lid:off output eDP-1 enable power on

bindsym Mod4+space input type:keyboard xkb_switch_layout next

bindsym --no-repeat Print exec sh -c 'mkdir -p "$HOME/Pictures/Screenshots"; geometry=$(slurp -b "#09090bbf" -c "#fafafa" -s "#00000000" -w 2) || exit; grim -g "$geometry" - | tee "$HOME/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png" | wl-copy --type image/png'
bindsym --no-repeat $mod+s exec sh -c 'mkdir -p "$HOME/Pictures/Screenshots"; geometry=$(slurp -b "#09090bbf" -c "#fafafa" -s "#00000000" -w 2) || exit; grim -g "$geometry" - | tee "$HOME/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png" | wl-copy --type image/png'

bindsym --no-repeat Shift+Print exec sh -c 'mkdir -p "$HOME/Pictures/Screenshots"; grim - | tee "$HOME/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png" | wl-copy --type image/png'
bindsym --no-repeat $mod+Shift+s exec sh -c 'mkdir -p "$HOME/Pictures/Screenshots"; grim - | tee "$HOME/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png" | wl-copy --type image/png'

# Gravação de tela: iniciar e parar com o mesmo atalho.
bindsym --no-repeat $mod+Ctrl+s exec @HOME@/.local/bin/sway-screen-recording

default_border pixel 2
default_floating_border pixel 2
