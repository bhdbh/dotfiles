{
  "workbench.colorTheme": "Monokai",
  "workbench.productIconTheme": "Default",
  "workbench.startupEditor": "none",
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.tabSizing": "shrink",
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.enablePreview": false,
  "workbench.editor.empty.hint": "hidden",
  "workbench.tree.indent": 16,
  "workbench.tree.renderIndentGuides": "always",
  "workbench.list.smoothScrolling": true,
  "workbench.statusBar.visible": true,
  "workbench.activityBar.location": "default",
  "window.commandCenter": false,
  "window.zoomLevel": 0,
  "breadcrumbs.enabled": true,

  "editor.fontFamily": "'Red Hat Mono', monospace",
  "editor.fontSize": 14,
  "editor.fontWeight": "400",
  "editor.fontLigatures": true,
  "editor.lineHeight": 23,
  "editor.letterSpacing": 0.2,

  "editor.cursorStyle": "line",
  "editor.cursorWidth": 2,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.mouseWheelScrollSensitivity": 1,
  "editor.fastScrollSensitivity": 5,
  "editor.scrollBeyondLastLine": false,

  "editor.minimap.enabled": true,
  "editor.minimap.side": "right",
  "editor.minimap.renderCharacters": false,
  "editor.minimap.scale": 1,
  "editor.minimap.size": "fit",
  "editor.minimap.showSlider": "mouseover",
  "editor.minimap.maxColumn": 100,

  "editor.wordWrap": "off",
  "editor.lineNumbers": "on",
  "editor.renderLineHighlight": "all",
  "editor.renderLineHighlightOnlyWhenFocus": false,
  "editor.guides.indentation": true,
  "editor.guides.highlightActiveIndentation": true,
  "editor.guides.bracketPairs": "active",
  "editor.bracketPairColorization.enabled": true,
  "editor.matchBrackets": "always",
  "editor.stickyScroll.enabled": true,
  "editor.stickyScroll.maxLineCount": 3,
  "editor.folding": true,
  "editor.foldingStrategy": "auto",
  "editor.showFoldingControls": "mouseover",
  "editor.renderWhitespace": "selection",
  "editor.renderControlCharacters": false,
  "editor.glyphMargin": true,
  "editor.linkedEditing": true,

  "editor.autoIndent": "full",
  "editor.autoClosingBrackets": "always",
  "editor.autoClosingQuotes": "always",
  "editor.autoSurround": "languageDefined",
  "editor.suggestSelection": "first",
  "editor.acceptSuggestionOnEnter": "on",
  "editor.inlineSuggest.enabled": false,
  "editor.parameterHints.enabled": true,
  "editor.tabCompletion": "on",
  "editor.snippetSuggestions": "inline",
  "editor.detectIndentation": true,
  "editor.insertSpaces": true,
  "editor.tabSize": 2,

  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.formatOnType": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  "prettier.semi": true,
  "prettier.singleQuote": true,
  "prettier.trailingComma": "all",
  "prettier.tabWidth": 2,
  "prettier.useTabs": false,
  "prettier.printWidth": 100,
  "prettier.bracketSpacing": true,
  "prettier.arrowParens": "always",

  "eslint.enable": true,
  "eslint.run": "onType",
  "eslint.format.enable": false,
  "eslint.workingDirectories": [
    {
      "mode": "auto",
    },
  ],

  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "always",
  },

  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },

  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.encoding": "utf8",
  "files.eol": "\n",

  "explorer.confirmDragAndDrop": false,
  // Operações internas usam o VS Code; seletores externos e exclusão usam o Yazi.
  "explorer.enableDragAndDrop": true,
  "window.dialogStyle": "custom",
  "explorer.compactFolders": false,
  "explorer.decorations.badges": true,
  "explorer.decorations.colors": true,

  "search.smartCase": true,
  "search.useIgnoreFiles": true,

  "git.autofetch": true,
  "git.enableSmartCommit": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": true,

  "terminal.integrated.fontFamily": "Red Hat Mono",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorWidth": 2,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.tabs.enabled": true,

  "tailwindCSS.classAttributes": ["class", "className", "ngClass"],

  "workbench.colorCustomizations": {
    "[Monokai]": {
      "editorCursor.foreground": "#F8F8F2",
      "editor.lineHighlightBackground": "#FFFFFF09",
      "editor.selectionBackground": "#75715E55",
      "editorIndentGuide.activeBackground1": "#A6E22E80",
      "editorBracketMatch.border": "#A6E22E",
      "editorBracketMatch.background": "#A6E22E20",
      "minimap.selectionHighlight": "#A6E22E40",
      "scrollbarSlider.background": "#88888830",
      "scrollbarSlider.hoverBackground": "#88888855",
    },
  },
  "github.copilot.enable": {
    "*": false,
  },
  "workbench.browser.enableChatTools": false,
  "workbench.browser.sendElementsToChat.attachImages": false,
  "chat.agent.enabled": false,
  "chat.agent.sandbox.network.allowNetwork": false,
  "chat.agent.sandbox.allowUnsandboxedCommands": false,
  "chat.agent.sandbox.mcpServers": false,
  "chat.agent.sandbox.lspServers": false,
  "chat.agent.sandbox.credentials.authenticategit": false,
  "chat.agent.sandbox.credentials.authenticategh": false,
  "chat.agent.sandbox.fileSystem.allowDevToolAccess": false,
  "workbench.commandPalette.showAskInChat": false,
  "chat.editor.preferCopilotHarness": false,
  "chat.defaultToCopilotHarness": false,
  "chat.agentSessions.migrateLegacyCopilotCli": false,
  "chat.copilot.dynamicAutoTiers.enabled": false,
  "chat.copilot.memory.enabled": false,
  "chat.copilotCliCommand.enabled": false,
  "chat.customizations.copilotConnectors.enabled": false,
  "chat.extensionUnification.enabled": false,
  "chat.mcp.discovery.enabled": {
    "claude-desktop": false,
    "copilot": false,
    "windsurf": false,
    "cursor-global": false,
    "cursor-workspace": false
  },
  "chat.implicitContext.includeActiveEditor": false,
  "terminal.integrated.tabs.allowAgentCliTitle": false,
  "chat.agentMerge.addressReviews": false,
  "chat.canvases.enabled": false,
  "chat.experimentalModePermissionsPicker": false,
  "chat.harnessSwitchFeedbackSurvey.enabled": false,
  "chat.titleBar.signIn.enabled": false,
  "dictation.experimental.llmCleanup": false,
  "telemetry.feedback.enabled": false,
  "telemetry.editStats.enabled": false,
  "telemetry.telemetryLevel": "off",
  "network.meteredConnection": "off",

  // Privacidade: sem IA integrada, experimentos ou recomendações automáticas.
  "workbench.enableExperiments": false,
  "workbench.settings.enableNaturalLanguageSearch": false,
  "workbench.settings.showAISearchToggle": false,
  "extensions.ignoreRecommendations": true,
  "chat.disableAIFeatures": true,
  "chat.agentsControl.enabled": "hidden",
  "chat.unifiedAgentsBar.enabled": false,
  "chat.mcp.access": "none",
  "chat.mcp.autostart": "never",
  "chat.mcp.gallery.enabled": false,
  "editor.aiStats.enabled": false,
  "remote.SSH.experimental.chat": false,
  "workbench.cloudChanges.autoResume": "off",
  "workbench.cloudChanges.continueOn": "off",
}
